+    fn status_line(port: u16, path: &str) -> String {
+        let mut stream = TcpStream::connect(("127.0.0.1", port)).unwrap();
+        write!(stream, "GET {path} HTTP/1.0\r\n\r\n").unwrap();
+        let mut response = String::new();
+        stream.read_to_string(&mut response).unwrap();
+        response.lines().next().unwrap_or_default().to_string()
+    }
+
+    #[test]
+    fn test_help_proxy_serves_same_user() {
+        // The proxy target accepts but never answers; the request below
+        // fails before reaching it anyway.
+        let target = TcpListener::bind("127.0.0.1:0").unwrap();
+        let (port, _handle) = super::start(target.local_addr().unwrap().port()).unwrap();
+
+        // The file doesn't exist, so the handler answers 502. A rejected
+        // connection would get 403 before reaching the handler.
+        let status = status_line(port, "/dev-figure?file=/nonexistent/ark-peer-check.png");
+        assert!(status.contains(" 502 "), "unexpected status: {status}");
+    }
+
+    /// Run by the build workflow: `ARK_HELP_PROXY_PORT_FILE=<file>` starts the
+    /// proxy, writes its port to the file and keeps it running until
+    /// `<file>.done` exists, so requests from other users can be made.
+    #[test]
+    fn test_help_proxy_from_env() {
+        let Ok(port_file) = std::env::var("ARK_HELP_PROXY_PORT_FILE") else {
+            return;
+        };
+        let target = TcpListener::bind("127.0.0.1:0").unwrap();
+        let (port, _handle) = super::start(target.local_addr().unwrap().port()).unwrap();
+        std::fs::write(&port_file, port.to_string()).unwrap();
+
+        let done = format!("{port_file}.done");
+        let start = Instant::now();
+        while !std::path::Path::new(&done).exists() {
+            assert!(start.elapsed() < Duration::from_secs(300), "timed out");
+            std::thread::sleep(Duration::from_millis(200));
+        }
+    }
+}
