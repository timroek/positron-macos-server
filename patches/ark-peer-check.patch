+
+    fn last_os_error(what: &str) -> anyhow::Error {
+        anyhow!("{what}: {}", std::io::Error::last_os_error())
+    }
+
+    fn pids_of_user(uid: libc::uid_t) -> anyhow::Result<Vec<libc::pid_t>> {
+        // Grow the buffer until it is larger than the result, so a process
+        // started between the two calls can't be missed silently.
+        let mut capacity = 1024usize;
+        loop {
+            let mut pids: Vec<libc::pid_t> = vec![0; capacity];
+            let bytes = unsafe {
+                libc::proc_listpids(
+                    PROC_UID_ONLY,
+                    uid,
+                    pids.as_mut_ptr().cast(),
+                    (capacity * size_of::<libc::pid_t>()) as libc::c_int,
+                )
+            };
+            if bytes < 0 {
+                return Err(last_os_error("proc_listpids"));
+            }
+            let count = bytes as usize / size_of::<libc::pid_t>();
+            if count < capacity {
+                pids.truncate(count);
+                pids.retain(|pid| *pid > 0);
+                return Ok(pids);
+            }
+            capacity *= 2;
+        }
+    }
+
+    fn socket_fds_of(pid: libc::pid_t) -> Option<Vec<i32>> {
+        let mut capacity = 256usize;
+        loop {
+            let mut fds: Vec<libc::proc_fdinfo> = vec![
+                libc::proc_fdinfo {
+                    proc_fd: 0,
+                    proc_fdtype: 0,
+                };
+                capacity
+            ];
+            let bytes = unsafe {
+                libc::proc_pidinfo(
+                    pid,
+                    libc::PROC_PIDLISTFDS,
+                    0,
+                    fds.as_mut_ptr().cast(),
+                    (capacity * size_of::<libc::proc_fdinfo>()) as libc::c_int,
+                )
+            };
+            // The process may have exited, or may not be inspectable.
+            if bytes <= 0 {
+                return None;
+            }
+            let count = bytes as usize / size_of::<libc::proc_fdinfo>();
+            if count < capacity {
+                fds.truncate(count);
+                return Some(
+                    fds.iter()
+                        .filter(|fd| fd.proc_fdtype as libc::c_int == libc::PROX_FDTYPE_SOCKET)
+                        .map(|fd| fd.proc_fd)
+                        .collect(),
+                );
+            }
+            capacity *= 2;
+        }
+    }
+
+    fn tcp_endpoints(pid: libc::pid_t, fd: i32) -> Option<(SocketAddr, SocketAddr)> {
+        let mut info: SocketFdInfo = unsafe { std::mem::zeroed() };
+        let bytes = unsafe {
+            libc::proc_pidfdinfo(
+                pid,
+                fd,
+                PROC_PIDFDSOCKETINFO,
+                (&mut info as *mut SocketFdInfo).cast(),
+                size_of::<SocketFdInfo>() as libc::c_int,
+            )
+        };
+        if bytes <= 0 || info.psi.soi_kind != SOCKINFO_TCP {
+            return None;
+        }
+
+        let ini = unsafe { info.psi.soi_proto.pri_tcp.tcpsi_ini };
+        // Ports are stored in network byte order in the low 16 bits.
+        let lport = u16::from_be(ini.insi_lport as u16);
+        let fport = u16::from_be(ini.insi_fport as u16);
+        let (laddr, faddr) = if ini.insi_vflag & INI_IPV4 != 0 {
+            let l = unsafe { ini.insi_laddr.ina_46.i46a_addr4 };
+            let f = unsafe { ini.insi_faddr.ina_46.i46a_addr4 };
+            (IpAddr::V4(Ipv4Addr::from(l)), IpAddr::V4(Ipv4Addr::from(f)))
+        } else if ini.insi_vflag & INI_IPV6 != 0 {
+            let l = unsafe { ini.insi_laddr.ina_6 };
+            let f = unsafe { ini.insi_faddr.ina_6 };
+            (IpAddr::V6(Ipv6Addr::from(l)), IpAddr::V6(Ipv6Addr::from(f)))
+        } else {
+            return None;
+        };
+
+        Some((
+            super::canonical(SocketAddr::new(laddr, lport)),
+            super::canonical(SocketAddr::new(faddr, fport)),
+        ))
+    }
+
+    /// Does any process of the current effective user own a TCP socket with
+    /// local address `client` connected to `server`?
+    pub(super) fn current_user_has_socket(
+        client: SocketAddr,
+        server: SocketAddr,
+    ) -> anyhow::Result<bool> {
+        let uid = unsafe { libc::geteuid() };
+        for pid in pids_of_user(uid)? {
+            let Some(fds) = socket_fds_of(pid) else {
+                continue;
+            };
+            for fd in fds {
+                if tcp_endpoints(pid, fd) == Some((client, server)) {
+                    return Ok(true);
+                }
+            }
+        }
+        Ok(false)
+    }
+}
