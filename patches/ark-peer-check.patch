@@ -0,0 +1,526 @@
+//
+// peer_check.rs
+//
+// Added by the positron-macos-server build; not part of upstream ark.
+// Licensed under the MIT License, like the rest of ark.
+//
+
+//! Checks that a TCP connection to one of ark's loopback listeners comes from
+//! a process owned by the same user as ark.
+//!
+//! The DAP, LSP and help proxy servers listen on `127.0.0.1` without any
+//! authentication, so on a multi-user machine any local user could connect to
+//! them. Right after `accept()`, the listener calls [`is_same_user_peer()`]
+//! and drops the connection unless the client socket is owned by ark's own
+//! effective user. Every error fails closed.
+//!
+//! The check looks for the client end of the connection: a TCP socket whose
+//! local address is the accepted connection's peer address and whose remote
+//! address is the listener's address.
+//!
+//! - macOS: TCP has no `SO_PEERCRED`, so the sockets of all processes owned by
+//!   the current user are enumerated with libproc. Sockets of other users'
+//!   processes cannot be inspected, and are never matched.
+//! - Linux: `/proc/net/tcp` and `/proc/net/tcp6` list the owning uid of every
+//!   TCP socket.
+//! - Other platforms: no check is available; connections are accepted as
+//!   before.
+
+use std::net::IpAddr;
+use std::net::SocketAddr;
+
+/// Returns `true` if the TCP connection accepted on `local` from `peer`
+/// belongs to a process owned by the current effective user. Logs and returns
+/// `false` on rejection and on any error.
+pub fn is_same_user_peer(server: &str, local: SocketAddr, peer: SocketAddr) -> bool {
+    match peer_matches_current_user(local, peer) {
+        Ok(true) => true,
+        Ok(false) => {
+            log::warn!(
+                "{server}: Rejected connection from {peer}: \
+                 the client socket is not owned by the current user"
+            );
+            false
+        },
+        Err(err) => {
+            log::error!("{server}: Rejected connection from {peer}: peer check failed: {err:?}");
+            false
+        },
+    }
+}
+
+/// Same as [`is_same_user_peer()`] for a connection whose addresses could not
+/// be determined. Always rejects, so callers can fail closed.
+pub fn reject_unknown_peer(server: &str, err: impl std::fmt::Debug) -> bool {
+    log::error!("{server}: Rejected connection: can't determine socket addresses: {err:?}");
+    false
+}
+
+/// Normalises IPv4-mapped IPv6 addresses so both stacks compare equal.
+fn canonical(addr: SocketAddr) -> SocketAddr {
+    match addr.ip() {
+        IpAddr::V6(ip) => match ip.to_ipv4_mapped() {
+            Some(v4) => SocketAddr::new(IpAddr::V4(v4), addr.port()),
+            None => addr,
+        },
+        IpAddr::V4(_) => addr,
+    }
+}
+
+#[cfg(target_os = "macos")]
+fn peer_matches_current_user(local: SocketAddr, peer: SocketAddr) -> anyhow::Result<bool> {
+    macos::current_user_has_socket(canonical(peer), canonical(local))
+}
+
+#[cfg(target_os = "linux")]
+fn peer_matches_current_user(local: SocketAddr, peer: SocketAddr) -> anyhow::Result<bool> {
+    let uid = unsafe { libc::geteuid() };
+    linux::socket_owned_by(canonical(peer), canonical(local), uid)
+}
+
+#[cfg(not(any(target_os = "macos", target_os = "linux")))]
+fn peer_matches_current_user(_local: SocketAddr, _peer: SocketAddr) -> anyhow::Result<bool> {
+    Ok(true)
+}
+
