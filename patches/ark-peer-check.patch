+/// Result of the peer check, stored per connection by [`check_peer()`].
+#[derive(Clone, Copy)]
+struct SameUserPeer(bool);
+
+/// Checks, once per connection, that the client is owned by the same user as
+/// ark. The proxy serves files from the R session, so other local users must
+/// not reach it.
+fn check_peer(connection: &dyn std::any::Any, data: &mut Extensions) {
+    let allowed = match connection.downcast_ref::<actix_web::rt::net::TcpStream>() {
+        Some(stream) => match (stream.local_addr(), stream.peer_addr()) {
+            (Ok(local), Ok(peer)) => crate::peer_check::is_same_user_peer("Help proxy", local, peer),
+            (Err(err), _) | (_, Err(err)) => {
+                crate::peer_check::reject_unknown_peer("Help proxy", err)
+            },
+        },
+        None => crate::peer_check::reject_unknown_peer("Help proxy", "not a TCP connection"),
+    };
+    data.insert(SameUserPeer(allowed));
+}
+
+/// Answers `403 Forbidden` to every request on a connection that failed the
+/// peer check (or was never checked).
+async fn reject_other_users<B: MessageBody + 'static>(
+    req: ServiceRequest,
+    next: Next<B>,
+) -> Result<ServiceResponse<impl MessageBody>, actix_web::Error> {
+    let allowed = req
+        .conn_data::<SameUserPeer>()
+        .is_some_and(|peer| peer.0);
+    if allowed {
+        Ok(next.call(req).await?.map_into_left_body())
+    } else {
+        Ok(req
+            .into_response(HttpResponse::Forbidden().finish())
+            .map_into_right_body())
+    }
+}
