+#[cfg(test)]
+mod tests {
+    use std::net::Ipv4Addr;
+    use std::net::SocketAddr;
+    use std::net::TcpListener;
+    use std::net::TcpStream;
+
+    use super::*;
+
+    #[test]
+    fn test_accepts_connection_from_same_process() {
+        let listener = TcpListener::bind("127.0.0.1:0").unwrap();
+        let _client = TcpStream::connect(listener.local_addr().unwrap()).unwrap();
+        let (stream, peer) = listener.accept().unwrap();
+        let local = stream.local_addr().unwrap();
+        assert!(is_same_user_peer("test", local, peer));
+    }
+
+    #[cfg(any(target_os = "macos", target_os = "linux"))]
+    #[test]
+    fn test_rejects_unknown_peer_port() {
+        let listener = TcpListener::bind("127.0.0.1:0").unwrap();
+        let _client = TcpStream::connect(listener.local_addr().unwrap()).unwrap();
+        let (stream, peer) = listener.accept().unwrap();
+        let local = stream.local_addr().unwrap();
+
+        // A peer port that has no socket connected to the listener. Port 1
+        // can't be a client port of an unprivileged process.
+        let unknown = SocketAddr::new(Ipv4Addr::LOCALHOST.into(), 1);
+        assert!(!is_same_user_peer("test", local, unknown));
+
+        // The real peer, but claimed on another listener port.
+        let other = SocketAddr::new(Ipv4Addr::LOCALHOST.into(), local.port().wrapping_add(1));
+        assert!(!is_same_user_peer("test", other, peer));
+    }
+
+    /// Run by the build workflow with a real client in another process:
+    /// `ARK_PEER_CHECK_LISTEN_FILE=<file>` makes this test listen, write its
+    /// port to the file and accept one connection. The connection must be
+    /// accepted if `ARK_PEER_CHECK_EXPECT=accept` (client of the same user)
+    /// and rejected otherwise (client of another user). Without the variable
+    /// the test does nothing.
+    #[test]
+    fn test_peer_from_env() {
+        let Ok(port_file) = std::env::var("ARK_PEER_CHECK_LISTEN_FILE") else {
+            return;
+        };
+        let expect_accept = std::env::var("ARK_PEER_CHECK_EXPECT").as_deref() == Ok("accept");
+
+        let listener = TcpListener::bind("127.0.0.1:0").unwrap();
+        let port = listener.local_addr().unwrap().port();
+        std::fs::write(&port_file, port.to_string()).unwrap();
+        let (stream, peer) = listener.accept().unwrap();
+        let local = stream.local_addr().unwrap();
+        assert_eq!(is_same_user_peer("test", local, peer), expect_accept);
+    }
+
+    #[cfg(target_os = "linux")]
+    #[test]
+    fn test_linux_find_owner() {
+        let table = "\
+  sl  local_address rem_address   st tx_queue rx_queue tr tm->when retrnsmt   uid  timeout inode
+   0: 0100007F:D431 0100007F:1F90 01 00000000:00000000 00:00000000 00000000  1000        0 1 1 0 20 4 30 10 -1
+   1: 0100007F:1F90 0100007F:D431 01 00000000:00000000 00:00000000 00000000   501        0 2 1 0 20 4 30 10 -1
+";
+        let client: SocketAddr = "127.0.0.1:54321".parse().unwrap();
+        let server: SocketAddr = "127.0.0.1:8080".parse().unwrap();
+        assert_eq!(
+            linux::find_owner(table, client, server).unwrap(),
+            Some(1000)
+        );
+        assert_eq!(linux::find_owner(table, server, client).unwrap(), Some(501));
+        let other: SocketAddr = "127.0.0.1:1".parse().unwrap();
+        assert_eq!(linux::find_owner(table, other, server).unwrap(), None);
+    }
+}
