+#[cfg(target_os = "linux")]
+mod linux {
+    use std::net::IpAddr;
+    use std::net::Ipv4Addr;
+    use std::net::Ipv6Addr;
+    use std::net::SocketAddr;
+
+    use anyhow::anyhow;
+    use anyhow::Context;
+
+    /// Parses an address such as `0100007F:1F90` from `/proc/net/tcp{,6}`.
+    fn parse_proc_addr(field: &str) -> anyhow::Result<SocketAddr> {
+        let (ip, port) = field
+            .split_once(':')
+            .ok_or_else(|| anyhow!("malformed address {field:?}"))?;
+        let port = u16::from_str_radix(port, 16)?;
+        let ip = match ip.len() {
+            8 => {
+                let word = u32::from_str_radix(ip, 16)?;
+                IpAddr::V4(Ipv4Addr::from(word.to_ne_bytes()))
+            },
+            32 => {
+                let mut bytes = [0u8; 16];
+                for i in 0..4 {
+                    let word = u32::from_str_radix(&ip[i * 8..i * 8 + 8], 16)?;
+                    bytes[i * 4..i * 4 + 4].copy_from_slice(&word.to_ne_bytes());
+                }
+                IpAddr::V6(Ipv6Addr::from(bytes))
+            },
+            _ => return Err(anyhow!("malformed address {field:?}")),
+        };
+        Ok(super::canonical(SocketAddr::new(ip, port)))
+    }
+
+    /// Finds the owner of the socket with local address `client` connected to
+    /// `server` in a `/proc/net/tcp`-formatted table.
+    pub(super) fn find_owner(
+        table: &str,
+        client: SocketAddr,
+        server: SocketAddr,
+    ) -> anyhow::Result<Option<u32>> {
+        for line in table.lines().skip(1) {
+            let fields: Vec<&str> = line.split_whitespace().collect();
+            if fields.len() < 8 {
+                continue;
+            }
+            if parse_proc_addr(fields[1])? == client && parse_proc_addr(fields[2])? == server {
+                return Ok(Some(fields[7].parse()?));
+            }
+        }
+        Ok(None)
+    }
+
+    pub(super) fn socket_owned_by(
+        client: SocketAddr,
+        server: SocketAddr,
+        uid: u32,
+    ) -> anyhow::Result<bool> {
+        for path in ["/proc/net/tcp", "/proc/net/tcp6"] {
+            let table = match std::fs::read_to_string(path) {
+                Ok(table) => table,
+                // `tcp6` is missing when IPv6 is disabled.
+                Err(err) if err.kind() == std::io::ErrorKind::NotFound => continue,
+                Err(err) => return Err(err).with_context(|| format!("reading {path}")),
+            };
+            if let Some(owner) = find_owner(&table, client, server)? {
+                return Ok(owner == uid);
+            }
+        }
+        Ok(false)
+    }
+}
